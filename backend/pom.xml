<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ForgeOps backend — Phase 2 repository foundation.
      Modular monolith (single deployable). No business features are implemented in
      this phase; this POM intentionally declares only foundation dependencies.
      See ARCHITECTURE.md, DECISIONS.md (ADR-0002), and TASKS.md (Phase 2).
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.forgeops</groupId>
    <artifactId>forgeops-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>forgeops-backend</name>
    <description>ForgeOps — Engineering Operations &amp; Incident Intelligence Platform (backend foundation)</description>

    <properties>
        <!-- Java 21 per ADR-0002. -->
        <java.version>21</java.version>
        <!-- ArchUnit: enforce modular-monolith boundaries (foundation-only usage). -->
        <archunit.version>1.3.0</archunit.version>
        <!-- Bouncy Castle (Argon2 provider for spring-security-crypto). Not managed by the
             Spring Boot BOM, so pinned explicitly to a version compatible with the
             Spring Security 6.3 line in Boot 3.3.4. -->
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <!-- Nimbus JOSE + JWT: not managed by the Boot BOM unless Spring Security web is on
             the classpath, so pinned explicitly. Compatible with Java 21 / Spring 6.3. -->
        <nimbus-jose-jwt.version>9.40</nimbus-jose-jwt.version>
        <!-- Testcontainers version is managed by the Spring Boot 3.3.4 BOM (1.19.8).
             NOTE: neither 1.19.8 nor a 1.20.x override resolves the Docker Engine 29.x
             HTTP-400 /info issue (docker-java defaults to an API version Engine 29
             rejects). Verified by investigation; see TASKS.md Phase 4.1. The fix is an
             environment correction (lower the engine min-api-version, or run on a
             compatible Docker), not a Testcontainers bump — so no override is kept. -->
    </properties>

    <dependencies>
        <!-- Web: hosts the health endpoint now; REST surface in later phases. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: minimal health endpoint to prove the app starts (Phase 2 §7). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Validation: foundation for boundary input validation in later phases.
             Included now so validation conventions are available from the start. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Persistence (Phase 4.1): Spring Data JPA / Hibernate over PostgreSQL, the
             authoritative identity store (ADR-0003). Standard Spring relational stack. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway: versioned, SQL-first database migrations (ADR-0034). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (runtime). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Security Crypto ONLY: provides Argon2PasswordEncoder for password
             hashing (Phase 4.2 Slice 1, ADR-0031). This is the crypto module, NOT
             spring-boot-starter-security — no web filter chain, no authentication, no
             authorization is pulled in by this slice. Version managed by the Boot BOM. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Bouncy Castle: required at runtime by Argon2PasswordEncoder for the Argon2
             implementation. Version managed by the Boot BOM. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Nimbus JOSE + JWT: RS256 access-token signing (Phase 4.2 Slice 3, ADR-0032)
             and validation (Slice 4). Version managed by the Boot BOM. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- Spring Security (Phase 4.2 Slice 4): the minimal starter needed for a
             stateless Bearer-JWT filter chain that distinguishes authenticated vs
             unauthenticated requests. No OAuth2/OIDC, no sessions, no form login. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Test foundation (JUnit 5, Spring Boot Test, Mockito). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: real PostgreSQL for persistence integration tests (test only). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: makes module boundaries enforceable, not just documentary
             (Phase 2 §15). JUnit 5 flavor. Test scope only. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
